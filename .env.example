# ---- Jornal 360 · Backend ----
NODE_ENV=production
PORT=3001

# Supabase → Project Settings → Database → Connection string (URI).
# Use el "Session pooler" (puerto 5432) para un servidor siempre encendido como Railway.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SU_CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Claves secretas largas y aleatorias (por ejemplo: openssl rand -base64 48)
JWT_SECRETO=cambie-esto-por-una-clave-larga
QR_SECRETO=cambie-esto-por-otra-clave-larga
JWT_HORAS=12

# Dirección del frontend en Vercel (para CORS y para los enlaces de los QR)
CORS_ORIGENES=https://su-app.vercel.app
URL_FRONTEND=https://su-app.vercel.app

# Superusuario inicial (solo se usa si la base no tiene usuarios)
SUPERADMIN_USUARIO=Santiago
SUPERADMIN_PASSWORD=123456santiago

# Crea tablas faltantes y datos iniciales al arrancar (no borra nada)
MIGRAR_AL_INICIAR=true
# Colombia: UTC-5
DESFASE_MINUTOS=-300
