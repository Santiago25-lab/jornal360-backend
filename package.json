    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
